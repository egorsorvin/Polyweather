[Unit]
Description=Polyweather order-book logger (Polymarket temperature markets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User and the two paths below if your user or checkout folder differ.
User=ubuntu
WorkingDirectory=/home/ubuntu/Polyweather
ExecStart=/home/ubuntu/Polyweather/.venv/bin/python logger/book_logger.py --out data/orderbook
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
